{
  "name": "tanktangle",
  "version": "1.0.0",
  "description": "Retro pixel maze tank battles for 2 to 12 players. Share a link, ricochet, blow up the walls.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/vt323": "5.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.6",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true,
    "workerd@1.20261012.1": true,
    "esbuild@0.28.2": true
  }
}
